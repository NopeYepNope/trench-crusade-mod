# Trench Crusade - Holy Faction Unique Land Units
# db/units/holy_land_units.txt
#
# Units exclusive to Holy factions or specific Holy nations.
# These are unlocked through faction-specific tech branches
# or the Divine Mysteries supernatural tree.

# ============================================================
# PALADIN (NAT only — unlocked by Crusader Order Structure)
# Elite heavy infantry, very high morale, expensive
# ============================================================

unit = {
	name = "Paladin"
	type = land
	model = 1

	default_organisation = 45
	morale = 9.0
	is_stavka = no

	max_speed = 3
	terrain_speed = { desert = 0.80 arctic = 0.65 mountain = 0.65 }

	defensiveness = 1.5
	toughness = 0.7		# blessed armour is genuinely harder to kill
	softness = 0.40		# heavy infantry
	suppression = 3
	air_attack = 0

	# Paladins are especially effective against demonic units
	hard_attack = 4.0
	soft_attack = 3.5

	supply_consumption = 0.60
	fuel_consumption = 0

	build_time = 365		# slow to train — requires extensive spiritual preparation
	manpower = 500
	ic_cost = 18

	allowed_brigades = { NAT }
}

