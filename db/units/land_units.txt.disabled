# Trench Crusade - Base Land Units
# db/units/land_units.txt
#
# Units available to all factions.
# Faction-specific supernatural units are in separate files.
# Stats are tuned for a WW1-era game where the front moves slowly
# and attrition is the primary mechanic.

# ============================================================
# INFANTRY (base unit — everyone starts with this)
# ============================================================

unit = {
	name = "Infantry"
	type = land
	model = 0

	# Combat stats
	default_organisation = 30
	morale = 5.0
	is_stavka = no

	# Movement
	max_speed = 3
	terrain_speed = { desert = 0.85 arctic = 0.75 mountain = 0.70 }

	# Combat values
	defensiveness = 1.0
	toughness = 0.4
	softness = 0.67
	suppression = 1
	air_attack = 0

	# Supply
	supply_consumption = 0.35
	fuel_consumption = 0

	# Build cost
	build_time = 120
	manpower = 1000
	ic_cost = 5

	# Upgrades to
	upgrade = { type = light_infantry }
	upgrade = { type = assault_infantry }
}

