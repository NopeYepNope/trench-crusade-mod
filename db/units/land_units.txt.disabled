# ============================================================
# GAS TROOPS (PRU only — unlocked by Gas Warfare Doctrine)
# ============================================================

unit = {
	name = "Gas Troops"
	type = land
	model = 0

	default_organisation = 25
	morale = 5.5
	is_stavka = no

	max_speed = 3
	terrain_speed = { desert = 0.85 arctic = 0.70 mountain = 0.65 }

	defensiveness = 0.5
	toughness = 0.35
	softness = 0.55
	suppression = 3		# high suppression — gas demoralises
	air_attack = 0

	# High soft attack — gas is devastating against unprotected infantry
	soft_attack = 8.0

	supply_consumption = 0.50
	fuel_consumption = 0

	build_time = 150
	manpower = 500
	ic_cost = 10

	allowed_brigades = { PRU }
}
