# ============================================================
# ENGINEER (unlocked by Trench Engineering tech)
# ============================================================

unit = {
	name = "Engineer"
	type = land
	model = 0

	default_organisation = 25
	morale = 5.0
	is_stavka = no

	max_speed = 3
	terrain_speed = { desert = 0.85 arctic = 0.75 mountain = 0.70 }

	defensiveness = 1.3		# engineers are specialists at fortification
	toughness = 0.4
	softness = 0.67
	suppression = 1
	air_attack = 0

	# Engineers also speed up fort construction
	fort_efficiency = 1.5

	supply_consumption = 0.40
	fuel_consumption = 0

	build_time = 150
	manpower = 500
	ic_cost = 7
}

# ============================================================
# LIGHT INFANTRY (unlocked by Assault Tactics tech)
# Faster, better in corrupted terrain, lower firepower
# ============================================================

unit = {
	name = "Light Infantry"
	type = land
	model = 0

	default_organisation = 30
	morale = 6.0
	is_stavka = no

	max_speed = 5
	terrain_speed = { desert = 1.0 arctic = 0.85 mountain = 0.90 }

	defensiveness = 0.8
	toughness = 0.35
	softness = 0.75
	suppression = 1
	air_attack = 0

	supply_consumption = 0.30
	fuel_consumption = 0

	build_time = 120
	manpower = 750
	ic_cost = 6

	# Key advantage — moves well through corrupted terrain
	# (represented by high desert/mountain speed as proxy)
}

